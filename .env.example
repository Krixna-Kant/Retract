# FalkorDB connection (local Docker by default; works with FalkorDB Cloud too)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# Optional LLM. Leave all empty to run the deterministic offline router.
# Pick ONE provider. RETRACT never lets the LLM write Cypher.
# Every provider with a key is used, in this order, falling back on errors.
LLM_PROVIDER=            # optional: which provider to try first (gemini | groq | openai | anthropic)
LLM_ROUTER=off           # off: rule-based router (default, fast, deterministic) | on: LLM picks tools, rules on failure
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
