# FalkorDB connection (local Docker by default; works with FalkorDB Cloud too)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# Optional LLM. Leave all empty to run the deterministic offline router.
# Pick ONE provider. RETRACT never lets the LLM write Cypher.
LLM_PROVIDER=            # gemini | openai | anthropic | (empty = offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
